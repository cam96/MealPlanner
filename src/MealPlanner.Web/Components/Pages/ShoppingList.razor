@page "/shopping-list"
@using System.Globalization
@using MealPlanner.Web.Components.Dialogs
@inject MealPlannerApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Shopping list - MealPlanner</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">Shopping list</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.AttachMoney"
                   OnClick="RecordPriceWithPickerAsync"
                   Size="Size.Small"
                   Class="mr-2">
            Record price
        </MudButton>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="PreviousMonthAsync" />
        <MudText Typo="Typo.h6" Style="min-width: 180px; text-align: center;">@MonthLabel</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="NextMonthAsync" />
    </MudStack>
</MudStack>

<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
    Combined from the month's planned meals, minus what's already in your pantry and freezer. Costs
    use each ingredient's preferred store; estimated costs are marked with an asterisk.
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else if (_list is not null)
{
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle1">Estimated total</MudText>
                <MudText Typo="Typo.h5">
                    @_list.EstimatedTotal.ToString("C", Culture)@(_list.IsEstimated ? "*" : string.Empty)
                </MudText>
            </MudStack>
            <MudStack Spacing="0" AlignItems="AlignItems.End">
                <MudText Typo="Typo.subtitle1">Monthly budget</MudText>
                <MudText Typo="Typo.h6">@_list.MonthlyBudget.ToString("C", Culture)</MudText>
            </MudStack>
        </MudStack>

        @if (_list.MonthlyBudget > 0)
        {
            <MudProgressLinear Value="@BudgetProgress"
                               Color="@(_list.IsOverBudget ? Color.Error : Color.Success)"
                               Class="my-3"
                               Size="Size.Large" />
            <MudText Typo="Typo.body2" Class="@(_list.IsOverBudget ? "mud-error-text" : "mud-text-secondary")">
                @if (_list.IsOverBudget)
                {
                    <text>Over budget by @((-_list.RemainingBudget).ToString("C", Culture)).</text>
                }
                else
                {
                    <text>@_list.RemainingBudget.ToString("C", Culture) remaining.</text>
                }
            </MudText>
        }
    </MudPaper>

    @* Add manual item form *@
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAutocomplete T="IngredientDto"
                             Label="Add an item"
                             Placeholder="Search ingredients or type a custom name"
                             Value="_selectedIngredient"
                             ValueChanged="OnIngredientSelected"
                             SearchFunc="SearchIngredientsAsync"
                             ToStringFunc="@(i => i?.Name ?? string.Empty)"
                             ResetValueOnEmptyText="true"
                             CoerceText="false"
                             CoerceValue="false"
                             Variant="Variant.Outlined"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             Style="flex: 1;"
                             TextChanged="OnSearchTextChanged"
                             OnKeyDown="OnAddItemKeyDownAsync">
                <NoItemsTemplate>
                    <MudText Typo="Typo.body2" Class="pa-2">
                        No matching ingredients. Press <b>Add</b> to add as custom text.
                    </MudText>
                </NoItemsTemplate>
            </MudAutocomplete>
            <MudNumericField @bind-Value="_newItemQuantity"
                             Label="Qty"
                             Variant="Variant.Outlined"
                             Min="0.0"
                             Style="max-width: 100px;" />
            <MudSelect @bind-Value="_newItemUnit"
                       Label="Unit"
                       Variant="Variant.Outlined"
                       Style="max-width: 100px;"
                       Clearable="true">
                <MudSelectItem Value="@((MeasurementUnit?)MeasurementUnit.Gram)">g</MudSelectItem>
                <MudSelectItem Value="@((MeasurementUnit?)MeasurementUnit.Millilitre)">ml</MudSelectItem>
                <MudSelectItem Value="@((MeasurementUnit?)MeasurementUnit.Each)">each</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="AddManualItemAsync"
                       Disabled="@(!CanAddItem)"
                       StartIcon="@Icons.Material.Filled.Add">
                Add
            </MudButton>
        </MudStack>
    </MudPaper>

    @* To Buy section *@
    @if (ToBuyLines.Count == 0 && ToBuyManual.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            Nothing left to buy! Plan some meals, add items manually, or your pantry already covers everything.
        </MudAlert>
    }
    else
    {
        @foreach (var group in ToBuyLines.GroupBy(l => l.StoreName ?? "Unpriced"))
        {
            <MudText Typo="Typo.h6" Class="mt-4 mb-2">@group.Key</MudText>
            <MudSimpleTable Hover="true" Dense="true" Elevation="1">
                <thead>
                    <tr>
                        <th style="width: 48px;"></th>
                        <th>Ingredient</th>
                        <th style="text-align:right;">To buy</th>
                        <th style="text-align:right;">Packages</th>
                        <th style="text-align:right;">Cost</th>
                        <th>Flags</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in group)
                    {
                        <tr @key="line.IngredientId">
                            <td>
                                <MudCheckBox T="bool"
                                             Value="line.IsInCart"
                                             ValueChanged="@(_ => ToggleGeneratedCartAsync(line.IngredientId))"
                                             Color="Color.Primary" />
                            </td>
                            <td>@line.IngredientName</td>
                            <td style="text-align:right;">
                                @line.ToBuyQuantity.ToString("0.#") @UnitLabel(line.Unit)
                                @if (line.PantryQuantity > 0)
                                {
                                    <MudTooltip Text="@($"{line.PantryQuantity:0.#} {UnitLabel(line.Unit)} already on hand")">
                                        <MudIcon Icon="@Icons.Material.Filled.Kitchen" Size="Size.Small" />
                                    </MudTooltip>
                                }
                            </td>
                            <td style="text-align:right;">@(line.PackagesToBuy > 0 ? line.PackagesToBuy.ToString() : "-")</td>
                            <td style="text-align:right;">
                                @line.EstimatedCost.ToString("C", Culture)@(line.IsCostEstimated ? "*" : string.Empty)
                            </td>
                            <td>
                                @if (line.IsDeal)
                                {
                                    <MudTooltip Text="@($"{line.PercentBelowAverage:0}% below the historical average")">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="ma-1">Deal</MudChip>
                                    </MudTooltip>
                                }
                                @if (line.IsBulk)
                                {
                                    <MudTooltip Text="A single package covers well over what you need">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ma-1">Bulk</MudChip>
                                    </MudTooltip>
                                }
                                @if (line.IsShared)
                                {
                                    <MudTooltip Text="Used across more than one recipe">
                                        <MudChip T="string" Size="Size.Small" Class="ma-1">Shared</MudChip>
                                    </MudTooltip>
                                }
                                <MudTooltip Text="Record a price for this ingredient">
                                    <MudIconButton Icon="@Icons.Material.Filled.AttachMoney"
                                                   Size="Size.Small"
                                                   OnClick="@(() => RecordPriceForIngredientAsync(line.IngredientId, line.IngredientName))" />
                                </MudTooltip>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }

        @if (ToBuyManual.Count > 0)
        {
            <MudText Typo="Typo.h6" Class="mt-4 mb-2">Other items</MudText>
            <MudSimpleTable Hover="true" Dense="true" Elevation="1">
                <thead>
                    <tr>
                        <th style="width: 48px;"></th>
                        <th>Item</th>
                        <th style="text-align:right;">Quantity</th>
                        <th style="text-align:right;">Price</th>
                        <th style="width: 48px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ToBuyManual)
                    {
                        <tr @key="item.Id">
                            <td>
                                <MudCheckBox T="bool"
                                             Value="item.IsInCart"
                                             ValueChanged="@(_ => ToggleManualCartAsync(item.Id))"
                                             Color="Color.Primary" />
                            </td>
                            <td>
                                @item.Name
                                @if (item.IngredientId.HasValue)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small"
                                             Class="ml-1 mud-text-secondary" />
                                }
                            </td>
                            <td style="text-align:right;">
                                @if (item.Quantity.HasValue)
                                {
                                    @item.Quantity.Value.ToString("0.#")
                                    @if (item.Unit.HasValue)
                                    {
                                        @(" ")@UnitLabel(item.Unit.Value)
                                    }
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </td>
                            <td style="text-align:right;">
                                @if (item.Prices.Count > 0)
                                {
                                    var preferred = item.Prices.FirstOrDefault(p => p.IsPreferredStore)
                                                   ?? item.Prices[0];
                                    <MudTooltip>
                                        <ChildContent>
                                            <span>@preferred.Price.ToString("C", Culture)</span>
                                        </ChildContent>
                                        <TooltipContent>
                                            <MudStack Spacing="1">
                                                @foreach (var price in item.Prices.Take(5))
                                                {
                                                    <MudText Typo="Typo.caption">
                                                        @price.StoreName: @price.Price.ToString("C", Culture)
                                                        (@price.PackageQuantity.ToString("0.#") @UnitLabel(price.PackageUnit))
                                                        — @price.RecordedDate.ToString("MMM d, yyyy")
                                                        @(price.IsPreferredStore ? " ★" : "")
                                                    </MudText>
                                                }
                                            </MudStack>
                                        </TooltipContent>
                                    </MudTooltip>
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </td>
                            <td>
                                @if (item.IngredientId.HasValue)
                                {
                                    <MudTooltip Text="Record a price for this ingredient">
                                        <MudIconButton Icon="@Icons.Material.Filled.AttachMoney"
                                                       Size="Size.Small"
                                                       OnClick="@(() => RecordPriceForIngredientAsync(item.IngredientId.Value, item.Name))" />
                                    </MudTooltip>
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               OnClick="@(() => DeleteManualItemAsync(item.Id))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }

    @* In the Cart section *@
    @if (HasCartItems)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-6 mb-2">
            <MudText Typo="Typo.h5">
                <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-1" />
                In the cart
            </MudText>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.RemoveShoppingCart"
                       OnClick="ClearCartAsync">
                Clear cart
            </MudButton>
        </MudStack>

        <MudSimpleTable Hover="true" Dense="true" Elevation="1">
            <thead>
                <tr>
                    <th style="width: 48px;"></th>
                    <th>Item</th>
                    <th style="text-align:right;">Quantity</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in InCartLines)
                {
                    <tr @key="line.IngredientId" style="opacity: 0.6;">
                        <td>
                            <MudCheckBox T="bool"
                                         Value="line.IsInCart"
                                         ValueChanged="@(_ => ToggleGeneratedCartAsync(line.IngredientId))"
                                         Color="Color.Primary" />
                        </td>
                        <td><s>@line.IngredientName</s></td>
                        <td style="text-align:right;">
                            @line.ToBuyQuantity.ToString("0.#") @UnitLabel(line.Unit)
                        </td>
                    </tr>
                }
                @foreach (var item in InCartManual)
                {
                    <tr @key="item.Id" style="opacity: 0.6;">
                        <td>
                            <MudCheckBox T="bool"
                                         Value="item.IsInCart"
                                         ValueChanged="@(_ => ToggleManualCartAsync(item.Id))"
                                         Color="Color.Primary" />
                        </td>
                        <td><s>@item.Name</s></td>
                        <td style="text-align:right;">
                            @if (item.Quantity.HasValue)
                            {
                                @item.Quantity.Value.ToString("0.#")
                                @if (item.Unit.HasValue)
                                {
                                    @(" ")@UnitLabel(item.Unit.Value)
                                }
                            }
                            else
                            {
                                <text>-</text>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
}

@code {
    private static readonly CultureInfo Culture = CultureInfo.GetCultureInfo("en-CA");

    private ShoppingListDto? _list;
    private IReadOnlyList<StoreDto> _stores = [];
    private bool _loading = true;
    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;

    private IngredientDto? _selectedIngredient;
    private string _searchText = string.Empty;
    private double? _newItemQuantity;
    private MeasurementUnit? _newItemUnit;

    private bool CanAddItem => _selectedIngredient is not null || !string.IsNullOrWhiteSpace(_searchText);

    private string MonthLabel =>
        new DateOnly(_year, _month, 1).ToString("MMMM yyyy", CultureInfo.CurrentCulture);

    private double BudgetProgress =>
        _list is null || _list.MonthlyBudget <= 0
            ? 0
            : Math.Min(100, (double)(_list.EstimatedTotal / _list.MonthlyBudget) * 100);

    private List<ShoppingListLineDto> ToBuyLines =>
        _list?.Lines.Where(l => !l.IsInCart).ToList() ?? [];

    private List<ManualShoppingItemDto> ToBuyManual =>
        _list?.ManualItems.Where(m => !m.IsInCart).ToList() ?? [];

    private List<ShoppingListLineDto> InCartLines =>
        _list?.Lines.Where(l => l.IsInCart).ToList() ?? [];

    private List<ManualShoppingItemDto> InCartManual =>
        _list?.ManualItems.Where(m => m.IsInCart).ToList() ?? [];

    private bool HasCartItems => InCartLines.Count > 0 || InCartManual.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        _stores = await Api.GetStoresAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _list = await Api.GetShoppingListAsync(_year, _month);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not load the shopping list. Is the API running?", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PreviousMonthAsync()
    {
        var previous = new DateOnly(_year, _month, 1).AddMonths(-1);
        _year = previous.Year;
        _month = previous.Month;
        await LoadAsync();
    }

    private async Task NextMonthAsync()
    {
        var next = new DateOnly(_year, _month, 1).AddMonths(1);
        _year = next.Year;
        _month = next.Month;
        await LoadAsync();
    }

    private async Task<IEnumerable<IngredientDto>> SearchIngredientsAsync(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return [];
        }

        return await Api.SearchIngredientsAsync(value, 10, ct);
    }

    private void OnIngredientSelected(IngredientDto? ingredient)
    {
        _selectedIngredient = ingredient;
        if (ingredient is not null)
        {
            _searchText = ingredient.Name;
        }
    }

    private void OnSearchTextChanged(string text)
    {
        _searchText = text ?? string.Empty;
        if (_selectedIngredient is not null && _selectedIngredient.Name != text)
        {
            _selectedIngredient = null;
        }
    }

    private async Task OnAddItemKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && CanAddItem)
        {
            await AddManualItemAsync();
        }
    }

    private async Task AddManualItemAsync()
    {
        if (!CanAddItem)
        {
            return;
        }

        try
        {
            var name = _selectedIngredient?.Name ?? _searchText.Trim();
            var ingredientId = _selectedIngredient?.Id;
            var request = new AddManualShoppingItemRequest(name, ingredientId, _newItemQuantity, _newItemUnit);
            await Api.AddManualShoppingItemAsync(_year, _month, request);
            _selectedIngredient = null;
            _searchText = string.Empty;
            _newItemQuantity = null;
            _newItemUnit = null;
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not add the item.", Severity.Error);
        }
    }

    private async Task DeleteManualItemAsync(int id)
    {
        try
        {
            await Api.DeleteManualShoppingItemAsync(_year, _month, id);
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not delete the item.", Severity.Error);
        }
    }

    private async Task ToggleGeneratedCartAsync(int ingredientId)
    {
        try
        {
            await Api.ToggleGeneratedItemCartAsync(_year, _month, ingredientId);
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not update the cart.", Severity.Error);
        }
    }

    private async Task ToggleManualCartAsync(int id)
    {
        try
        {
            await Api.ToggleManualItemCartAsync(_year, _month, id);
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not update the cart.", Severity.Error);
        }
    }

    private async Task ClearCartAsync()
    {
        try
        {
            await Api.ClearShoppingCartAsync(_year, _month);
            await LoadAsync();
            Snackbar.Add("Cart cleared.", Severity.Success);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not clear the cart.", Severity.Error);
        }
    }

    private async Task RecordPriceForIngredientAsync(int ingredientId, string ingredientName)
    {
        if (_stores.Count == 0)
        {
            Snackbar.Add("Add a store under Settings before recording prices.", Severity.Info);
            return;
        }

        var parameters = new DialogParameters<PriceDialog>
        {
            { x => x.Existing, null },
            { x => x.Stores, _stores },
            { x => x.ShowIngredientPicker, false },
            { x => x.IngredientId, ingredientId },
        };
        var options = DialogHelper.FormDialog();
        var dialog = await DialogService.ShowAsync<PriceDialog>($"Record price — {ingredientName}", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not SaveIngredientPriceRequest request)
        {
            return;
        }

        try
        {
            await Api.CreatePriceAsync(ingredientId, request);
            Snackbar.Add("Price recorded.", Severity.Success);
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not save the price.", Severity.Error);
        }
    }

    private async Task RecordPriceWithPickerAsync()
    {
        if (_stores.Count == 0)
        {
            Snackbar.Add("Add a store under Settings before recording prices.", Severity.Info);
            return;
        }

        var parameters = new DialogParameters<PriceDialog>
        {
            { x => x.Existing, null },
            { x => x.Stores, _stores },
            { x => x.ShowIngredientPicker, true },
        };
        var options = DialogHelper.FormDialog();
        var dialog = await DialogService.ShowAsync<PriceDialog>("Record price", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not PriceDialogResult dialogResult)
        {
            return;
        }

        try
        {
            await Api.CreatePriceAsync(dialogResult.IngredientId, dialogResult.Request);
            Snackbar.Add("Price recorded.", Severity.Success);
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not save the price.", Severity.Error);
        }
    }

    private static string UnitLabel(MeasurementUnit unit) => unit switch
    {
        MeasurementUnit.Millilitre => "ml",
        MeasurementUnit.Each => "each",
        _ => "g",
    };
}
