@page "/shopping-list"
@using System.Globalization
@using MealPlanner.Web.Components.Dialogs
@inject MealPlannerApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Shopping list - MealPlanner</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4" Class="d-none d-sm-block">Shopping list</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="PreviousMonthAsync" />
        <MudText Typo="Typo.h6" Style="min-width: 140px; text-align: center;">@MonthLabel</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="NextMonthAsync" />
    </MudStack>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else if (_list is not null)
{
    @* Budget summary *@
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudStack Spacing="0">
                <MudText Typo="Typo.caption">Estimated total</MudText>
                <MudText Typo="Typo.h6">
                    @_list.EstimatedTotal.ToString("C", Culture)@(_list.IsEstimated ? "*" : string.Empty)
                </MudText>
            </MudStack>
            <MudStack Spacing="0" AlignItems="AlignItems.End">
                <MudText Typo="Typo.caption">Budget</MudText>
                <MudText Typo="Typo.body1">@_list.MonthlyBudget.ToString("C", Culture)</MudText>
            </MudStack>
        </MudStack>

        @if (_list.MonthlyBudget > 0)
        {
            <MudProgressLinear Value="@BudgetProgress"
                               Color="@(_list.IsOverBudget ? Color.Error : Color.Success)"
                               Class="my-2"
                               Size="Size.Medium" />
            <MudText Typo="Typo.caption" Class="@(_list.IsOverBudget ? "mud-error-text" : "mud-text-secondary")">
                @if (_list.IsOverBudget)
                {
                    <text>Over by @((-_list.RemainingBudget).ToString("C", Culture))</text>
                }
                else
                {
                    <text>@_list.RemainingBudget.ToString("C", Culture) remaining</text>
                }
            </MudText>
        }
    </MudPaper>

    @if (UnpricedCount > 0)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.WarningAmber">
            @UnpricedCount item@(UnpricedCount == 1 ? " has" : "s have") no recorded price and
            @(UnpricedCount == 1 ? "is" : "are") not included in the total.
            Record prices to get an accurate budget estimate.
        </MudAlert>
    }

    @* On the shelf section *@
    @if (OnShelfItems.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            Nothing left to buy! Add items using the + button.
        </MudAlert>
    }
    else
    {
        <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1 d-block d-md-none mud-text-secondary">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Class="mr-1" />
            On the shelf
        </MudText>
        <MudText Typo="Typo.h6" Class="mt-4 mb-2 d-none d-md-block">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Class="mr-1" />
            On the shelf
        </MudText>

        @* Mobile card list *@
        <div class="d-block d-md-none">
            @foreach (var item in OnShelfItems)
            {
                <MudPaper Class="pa-2 mb-1" Elevation="0" Outlined="true" @key="item.Id">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudCheckBox T="bool"
                                     Value="item.IsInCart"
                                     ValueChanged="@(_ => ToggleCartAsync(item.Id))"
                                     Color="Color.Primary"
                                     Dense="true" />
                        <MudStack Spacing="0" Style="flex: 1; min-width: 0;">
                            <MudText Typo="Typo.body2" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @item.Name
                            </MudText>
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                @if (item.Quantity.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @item.Quantity.Value.ToString("0.#")@(item.Unit.HasValue ? $" {UnitLabel(item.Unit.Value)}" : "")
                                    </MudText>
                                }
                                @if (item.EstimatedCost > 0)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        · @item.EstimatedCost.ToString("C", Culture)@(item.IsCostEstimated ? "*" : "")
                                    </MudText>
                                }
                                else if (item.IsCostEstimated)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" Color="Color.Warning" />
                                }
                            </MudStack>
                        </MudStack>
                        @if (item.IngredientId.HasValue)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.AttachMoney"
                                           Size="Size.Small"
                                           OnClick="@(() => ShowPricesAsync(item.IngredientId.Value, item.Name))" />
                            <MudIconButton Icon="@Icons.Material.Filled.AddCard"
                                           Size="Size.Small"
                                           OnClick="@(() => RecordPriceForIngredientAsync(item.IngredientId.Value, item.Name))" />
                        }
                        else
                        {
                            <MudTooltip Text="Create as ingredient to track prices">
                                <MudIconButton Icon="@Icons.Material.Filled.SetMeal"
                                               Size="Size.Small"
                                               Color="Color.Info"
                                               OnClick="@(() => CreateIngredientFromManualItemAsync(item))" />
                            </MudTooltip>
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       OnClick="@(() => EditManualItemAsync(item))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteManualItemAsync(item.Id))" />
                    </MudStack>
                </MudPaper>
            }
        </div>

        @* Desktop table *@
        <div class="d-none d-md-block">
            <MudSimpleTable Hover="true" Dense="true" Elevation="1">
                <thead>
                    <tr>
                        <th style="width: 48px;"></th>
                        <th>Item</th>
                        <th style="text-align:right;">Qty</th>
                        <th style="text-align:right;">Cost</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in OnShelfItems)
                    {
                        <tr @key="item.Id">
                            <td>
                                <MudCheckBox T="bool"
                                             Value="item.IsInCart"
                                             ValueChanged="@(_ => ToggleCartAsync(item.Id))"
                                             Color="Color.Primary" />
                            </td>
                            <td>@item.Name</td>
                            <td style="text-align:right;">
                                @if (item.Quantity.HasValue)
                                {
                                    @item.Quantity.Value.ToString("0.#")
                                    @if (item.Unit.HasValue)
                                    {
                                        @(" ")@UnitLabel(item.Unit.Value)
                                    }
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </td>
                            <td style="text-align:right;">
                                @if (item.EstimatedCost > 0)
                                {
                                    @item.EstimatedCost.ToString("C", Culture)@(item.IsCostEstimated ? "*" : string.Empty)
                                }
                                else if (item.IsCostEstimated)
                                {
                                    <MudTooltip Text="No price recorded for this item">
                                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" Color="Color.Warning" />
                                    </MudTooltip>
                                }
                            </td>
                            <td>
                                @if (item.IngredientId.HasValue)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.AttachMoney"
                                                   Size="Size.Small"
                                                   OnClick="@(() => ShowPricesAsync(item.IngredientId.Value, item.Name))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.AddCard"
                                                   Size="Size.Small"
                                                   OnClick="@(() => RecordPriceForIngredientAsync(item.IngredientId.Value, item.Name))" />
                                }
                                else
                                {
                                    <MudTooltip Text="Create as ingredient to track prices">
                                        <MudIconButton Icon="@Icons.Material.Filled.SetMeal"
                                                       Size="Size.Small"
                                                       Color="Color.Info"
                                                       OnClick="@(() => CreateIngredientFromManualItemAsync(item))" />
                                    </MudTooltip>
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               OnClick="@(() => EditManualItemAsync(item))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               OnClick="@(() => DeleteManualItemAsync(item.Id))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    }

    @* In the Cart section *@
    @if (InCartItems.Count > 0)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-5 mb-2">
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small" Class="mr-1" />
                In the cart
            </MudText>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.RemoveShoppingCart"
                       OnClick="ClearCartAsync">
                Clear
            </MudButton>
        </MudStack>

        @* Mobile cart *@
        <div class="d-block d-md-none">
            @foreach (var item in InCartItems)
            {
                <MudPaper Class="pa-2 mb-1" Elevation="0" Outlined="true" Style="opacity: 0.6;" @key="item.Id">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudCheckBox T="bool"
                                     Value="item.IsInCart"
                                     ValueChanged="@(_ => ToggleCartAsync(item.Id))"
                                     Color="Color.Primary"
                                     Dense="true" />
                        <MudStack Spacing="0" Style="flex: 1; min-width: 0;">
                            <MudText Typo="Typo.body2" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                <s>@item.Name</s>
                            </MudText>
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                @if (item.Quantity.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @item.Quantity.Value.ToString("0.#")@(item.Unit.HasValue ? $" {UnitLabel(item.Unit.Value)}" : "")
                                    </MudText>
                                }
                                @if (item.EstimatedCost > 0)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        · @item.EstimatedCost.ToString("C", Culture)@(item.IsCostEstimated ? "*" : "")
                                    </MudText>
                                }
                            </MudStack>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            }
        </div>

        @* Desktop cart *@
        <div class="d-none d-md-block">
            <MudSimpleTable Hover="true" Dense="true" Elevation="1">
                <thead>
                    <tr>
                        <th style="width: 48px;"></th>
                        <th>Item</th>
                        <th style="text-align:right;">Qty</th>
                        <th style="text-align:right;">Cost</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in InCartItems)
                    {
                        <tr @key="item.Id" style="opacity: 0.6;">
                            <td>
                                <MudCheckBox T="bool"
                                             Value="item.IsInCart"
                                             ValueChanged="@(_ => ToggleCartAsync(item.Id))"
                                             Color="Color.Primary" />
                            </td>
                            <td><s>@item.Name</s></td>
                            <td style="text-align:right;">
                                @if (item.Quantity.HasValue)
                                {
                                    @item.Quantity.Value.ToString("0.#")
                                    @if (item.Unit.HasValue)
                                    {
                                        @(" ")@UnitLabel(item.Unit.Value)
                                    }
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </td>
                            <td style="text-align:right;">
                                @if (item.EstimatedCost > 0)
                                {
                                    @item.EstimatedCost.ToString("C", Culture)@(item.IsCostEstimated ? "*" : string.Empty)
                                }
                            </td>
                            <td></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    }
}

@* FAB — add shopping list item *@
<MudFab StartIcon="@Icons.Material.Filled.Add"
        Color="Color.Primary"
        Class="fab-bottom-right"
        OnClick="OpenAddItemDialogAsync" />

@code {
    private static readonly CultureInfo Culture = CultureInfo.GetCultureInfo("en-CA");

    private ShoppingListDto? _list;
    private IReadOnlyList<StoreDto> _stores = [];
    private bool _loading = true;
    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;

    private string MonthLabel =>
        new DateOnly(_year, _month, 1).ToString("MMMM yyyy", CultureInfo.CurrentCulture);

    private double BudgetProgress =>
        _list is null || _list.MonthlyBudget <= 0
            ? 0
            : Math.Min(100, (double)(_list.EstimatedTotal / _list.MonthlyBudget) * 100);

    private List<ManualShoppingItemDto> OnShelfItems =>
        _list?.Items.Where(m => !m.IsInCart).ToList() ?? [];

    private List<ManualShoppingItemDto> InCartItems =>
        _list?.Items.Where(m => m.IsInCart).ToList() ?? [];

    private int UnpricedCount =>
        _list?.Items.Count(m => m.IsCostEstimated && m.EstimatedCost == 0) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        _stores = await Api.GetStoresAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _list = await Api.GetShoppingListAsync(_year, _month);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not load the shopping list. Is the API running?", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PreviousMonthAsync()
    {
        var previous = new DateOnly(_year, _month, 1).AddMonths(-1);
        _year = previous.Year;
        _month = previous.Month;
        await LoadAsync();
    }

    private async Task NextMonthAsync()
    {
        var next = new DateOnly(_year, _month, 1).AddMonths(1);
        _year = next.Year;
        _month = next.Month;
        await LoadAsync();
    }

    private async Task OpenAddItemDialogAsync()
    {
        var options = DialogHelper.FormDialog();
        var dialog = await DialogService.ShowAsync<AddShoppingItemDialog>("Add item", options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not AddManualShoppingItemRequest request)
        {
            return;
        }

        try
        {
            await Api.AddManualShoppingItemAsync(_year, _month, request);
            Snackbar.Add("Item added.", Severity.Success);
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not add the item.", Severity.Error);
        }
    }

    private async Task DeleteManualItemAsync(int id)
    {
        try
        {
            await Api.DeleteManualShoppingItemAsync(_year, _month, id);
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not delete the item.", Severity.Error);
        }
    }

    private async Task EditManualItemAsync(ManualShoppingItemDto item)
    {
        var parameters = new DialogParameters<AddShoppingItemDialog>
        {
            { x => x.Existing, item },
        };
        var options = DialogHelper.FormDialog();
        var dialog = await DialogService.ShowAsync<AddShoppingItemDialog>("Edit item", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not AddManualShoppingItemRequest request)
        {
            return;
        }

        try
        {
            await Api.UpdateManualShoppingItemAsync(_year, _month, item.Id, request);
            Snackbar.Add("Item updated.", Severity.Success);
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not update the item.", Severity.Error);
        }
    }

    private async Task CreateIngredientFromManualItemAsync(ManualShoppingItemDto item)
    {
        var parameters = new DialogParameters<IngredientDialog>
        {
            { x => x.DefaultName, item.Name },
        };
        var options = DialogHelper.FormDialog();
        var dialog = await DialogService.ShowAsync<IngredientDialog>("Create ingredient", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not SaveIngredientRequest request)
        {
            return;
        }

        try
        {
            var ingredient = await Api.CreateIngredientAsync(request);
            if (ingredient is null)
            {
                Snackbar.Add("Could not create the ingredient.", Severity.Error);
                return;
            }

            var updateRequest = new AddManualShoppingItemRequest(
                item.Name,
                ingredient.Id,
                item.Quantity,
                item.Unit);
            await Api.UpdateManualShoppingItemAsync(_year, _month, item.Id, updateRequest);
            Snackbar.Add($"Created ingredient \"{ingredient.Name}\" and linked it.", Severity.Success);
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not create the ingredient.", Severity.Error);
        }
    }

    private async Task ToggleCartAsync(int id)
    {
        try
        {
            await Api.ToggleManualItemCartAsync(_year, _month, id);
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not update the cart.", Severity.Error);
        }
    }

    private async Task ClearCartAsync()
    {
        try
        {
            await Api.ClearShoppingCartAsync(_year, _month);
            await LoadAsync();
            Snackbar.Add("Cart cleared.", Severity.Success);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not clear the cart.", Severity.Error);
        }
    }

    private async Task ShowPricesAsync(int ingredientId, string ingredientName)
    {
        IReadOnlyList<IngredientPriceDto> prices;
        try
        {
            prices = await Api.GetPricesAsync(ingredientId);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not load prices.", Severity.Error);
            return;
        }

        if (prices.Count == 0)
        {
            Snackbar.Add($"No prices recorded for {ingredientName}.", Severity.Info);
            return;
        }

        var parameters = new DialogParameters<PriceListDialog>
        {
            { x => x.IngredientName, ingredientName },
            { x => x.Prices, prices },
        };
        var options = DialogHelper.ViewDialog();
        await DialogService.ShowAsync<PriceListDialog>($"Prices — {ingredientName}", parameters, options);
    }

    private async Task RecordPriceForIngredientAsync(int ingredientId, string ingredientName)
    {
        if (_stores.Count == 0)
        {
            Snackbar.Add("Add a store under Settings before recording prices.", Severity.Info);
            return;
        }

        var parameters = new DialogParameters<PriceDialog>
        {
            { x => x.Existing, null },
            { x => x.Stores, _stores },
            { x => x.ShowIngredientPicker, false },
            { x => x.IngredientId, ingredientId },
        };
        var options = DialogHelper.FormDialog();
        var dialog = await DialogService.ShowAsync<PriceDialog>($"Record price — {ingredientName}", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not SaveIngredientPriceRequest request)
        {
            return;
        }

        try
        {
            await Api.CreatePriceAsync(ingredientId, request);
            Snackbar.Add("Price recorded.", Severity.Success);
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not save the price.", Severity.Error);
        }
    }

    private static string UnitLabel(MeasurementUnit unit) => unit switch
    {
        MeasurementUnit.Millilitre => "ml",
        MeasurementUnit.Litre => "L",
        MeasurementUnit.Kilogram => "kg",
        MeasurementUnit.Pound => "lbs",
        MeasurementUnit.Each => "each",
        _ => "g",
    };
}