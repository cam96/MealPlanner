@page "/pending-approval"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Pending Approval - MealPlanner</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex align-center justify-center" Style="min-height: 70vh;">
            <MudCard Elevation="4" Class="pa-8" Style="width: 100%;">
                <MudCardContent Class="d-flex flex-column align-center gap-4">
                    <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Color="Color.Warning"
                             Style="font-size: 4rem;" />
                    <MudText Typo="Typo.h5" Align="Align.Center">Account Pending Approval</MudText>
                    <MudText Typo="Typo.body1" Align="Align.Center">
                        Hi <strong>@context.User.Identity?.Name</strong>! Your account has been
                        created, but an administrator needs to approve it before you can access
                        the application.
                    </MudText>
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                        Please check back later or contact your household admin.
                    </MudText>
                </MudCardContent>
                <MudCardActions Class="d-flex justify-center pa-4">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Logout"
                               Href="/auth/logout">
                        Sign out
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudContainer>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>
