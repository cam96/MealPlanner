@page "/prices"
@attribute [Authorize]
@using MealPlanner.Web.Components.Dialogs
@inject MealPlannerApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Prices - MealPlanner</PageTitle>

<MudText Typo="Typo.h5" Class="mb-2 d-none d-sm-block">Prices</MudText>

@* Search/filter bar *@
<MudPaper Class="pa-2 mb-3" Elevation="1">
    <MudTextField @bind-Value="_search"
                  Placeholder="Search by ingredient or store…"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true"
                  DebounceInterval="300"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  OnDebounceIntervalElapsed="OnSearchChangedAsync"
                  Class="mt-0" />
</MudPaper>

@* Recently priced quick-access chips *@
@if (_recentIngredients.Count > 0)
{
    <MudStack Row="true" Spacing="1" Class="mb-3 flex-wrap">
        <MudText Typo="Typo.caption" Class="mud-text-secondary align-self-center mr-1">Recent:</MudText>
        @foreach (var name in _recentIngredients)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                     OnClick="@(() => FilterByIngredient(name))">@name</MudChip>
        }
    </MudStack>
}

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
}

@* Mobile card list *@
<div class="d-block d-md-none">
    @if (_recentPrices.Count == 0 && !_loading)
    {
        <MudText Typo="Typo.body2" Class="pa-4 mud-text-secondary">
            @(string.IsNullOrWhiteSpace(_search) ? "No prices recorded yet. Tap + to record one." : "No prices match your search.")
        </MudText>
    }
    else
    {
        <MudList T="RecentPriceDto" Dense="true" Class="pa-0">
            @foreach (var price in _recentPrices)
            {
                <MudListItem T="RecentPriceDto" Class="price-card">
                    <MudStack Spacing="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body1" Class="fw-bold">@price.IngredientName</MudText>
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.body1" Color="Color.Primary">@price.Price.ToString("C2")</MudText>
                                @if (price.IsEstimated)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">est.</MudChip>
                                }
                            </MudStack>
                        </MudStack>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @price.StoreName · @price.PackageQuantity @UnitLabel(price.PackageUnit) · @price.RecordedDate.ToString("MMM d")
                                @if (price.IsPreferredStore)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Primary" Size="Size.Small" />
                                }
                            </MudText>
                            <MudStack Row="true" Spacing="0">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               OnClick="@(() => EditPriceAsync(price))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => DeletePriceAsync(price))" />
                            </MudStack>
                        </MudStack>
                    </MudStack>
                </MudListItem>
                <MudDivider />
            }
        </MudList>
    }
</div>

@* Desktop table view *@
<div class="d-none d-md-block">
    <MudDataGrid T="RecentPriceDto"
                 Items="_recentPrices"
                 Loading="_loading"
                 Hover="true"
                 Dense="true"
                 Elevation="1">
        <Columns>
            <PropertyColumn Property="p => p.IngredientName" Title="Ingredient" />
            <PropertyColumn Property="p => p.StoreName" Title="Store" />
            <TemplateColumn Title="Price" SortBy="p => p.Price">
                <CellTemplate>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText>@context.Item.Price.ToString("C2")</MudText>
                        @if (context.Item.IsEstimated)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">est.</MudChip>
                        }
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Package" Sortable="false">
                <CellTemplate>
                    @context.Item.PackageQuantity @UnitLabel(context.Item.PackageUnit)
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="p => p.RecordedDate" Title="Date" />
            <TemplateColumn Title="Pref" Sortable="false">
                <CellTemplate>
                    @if (context.Item.IsPreferredStore)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Primary" Size="Size.Small" />
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="0">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       OnClick="@(() => EditPriceAsync(context.Item))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => DeletePriceAsync(context.Item))" />
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Class="pa-4 mud-text-secondary">
                @(string.IsNullOrWhiteSpace(_search) ? "No prices recorded yet." : "No prices match your search.")
            </MudText>
        </NoRecordsContent>
    </MudDataGrid>
</div>

@* FAB — quick-record price *@
<MudFab StartIcon="@Icons.Material.Filled.Add"
        Color="Color.Primary"
        Class="fab-bottom-right"
        OnClick="QuickRecordPriceAsync" />

@code {
    private IReadOnlyList<RecentPriceDto> _recentPrices = [];
    private IReadOnlyList<StoreDto> _stores = [];
    private List<string> _recentIngredients = [];
    private bool _loading = true;
    private string _search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _stores = await Api.GetStoresAsync();
        await LoadRecentPricesAsync();
    }

    private async Task LoadRecentPricesAsync()
    {
        _loading = true;
        try
        {
            _recentPrices = await Api.GetRecentPricesAsync(_search);
            UpdateRecentIngredients();
        }
        finally
        {
            _loading = false;
        }
    }

    private void UpdateRecentIngredients()
    {
        _recentIngredients = _recentPrices
            .Select(p => p.IngredientName)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(8)
            .ToList();
    }

    private async Task OnSearchChangedAsync(string value)
    {
        _search = value;
        await LoadRecentPricesAsync();
    }

    private async Task FilterByIngredient(string name)
    {
        _search = name;
        await LoadRecentPricesAsync();
    }

    private async Task QuickRecordPriceAsync()
    {
        if (_stores.Count == 0)
        {
            Snackbar.Add("Add a store under Settings before recording prices.", Severity.Info);
            return;
        }

        var parameters = new DialogParameters<PriceDialog>
        {
            { x => x.Existing, null },
            { x => x.Stores, _stores },
            { x => x.ShowIngredientPicker, true },
        };
        var options = DialogHelper.FormDialog();
        var dialog = await DialogService.ShowAsync<PriceDialog>("Record price", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not PriceDialogResult dialogResult)
        {
            return;
        }

        try
        {
            await Api.CreatePriceAsync(dialogResult.IngredientId, dialogResult.Request);
            Snackbar.Add("Price recorded.", Severity.Success);
            await LoadRecentPricesAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not save the price. Is the API running?", Severity.Error);
        }
    }

    private async Task EditPriceAsync(RecentPriceDto price)
    {
        var existing = new IngredientPriceDto(
            price.Id,
            price.IngredientId,
            price.StoreId,
            price.StoreName,
            price.Price,
            price.PackageQuantity,
            price.PackageUnit,
            price.RecordedDate,
            price.IsEstimated,
            price.IsPreferredStore);

        var parameters = new DialogParameters<PriceDialog>
        {
            { x => x.Existing, existing },
            { x => x.Stores, _stores },
            { x => x.ShowIngredientPicker, false },
            { x => x.IngredientId, price.IngredientId },
        };
        var options = DialogHelper.FormDialog();
        var dialog = await DialogService.ShowAsync<PriceDialog>($"Edit price — {price.IngredientName}", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not SaveIngredientPriceRequest request)
        {
            return;
        }

        try
        {
            await Api.UpdatePriceAsync(price.IngredientId, price.Id, request);
            Snackbar.Add("Price updated.", Severity.Success);
            await LoadRecentPricesAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not update the price.", Severity.Error);
        }
    }

    private async Task DeletePriceAsync(RecentPriceDto price)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = "Delete price",
            MarkupMessage = new MarkupString($"Delete the {price.Price:C2} price for {price.IngredientName} at {price.StoreName}?"),
            YesText = "Delete",
            CancelText = "Cancel",
        });

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.DeletePriceAsync(price.IngredientId, price.Id);
            Snackbar.Add("Price deleted.", Severity.Success);
            await LoadRecentPricesAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not delete the price.", Severity.Error);
        }
    }

    private static string UnitLabel(MeasurementUnit unit) => unit switch
    {
        MeasurementUnit.Millilitre => "ml",
        MeasurementUnit.Litre => "L",
        MeasurementUnit.Kilogram => "kg",
        MeasurementUnit.Pound => "lbs",
        MeasurementUnit.Each => "each",
        _ => "g",
    };
}
