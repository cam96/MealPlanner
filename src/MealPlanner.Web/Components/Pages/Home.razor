@page "/"
@using System.Globalization
@inject MealPlannerApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Dashboard - MealPlanner</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">Dashboard</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="PreviousMonthAsync" />
        <MudText Typo="Typo.h6" Style="min-width: 180px; text-align: center;">@MonthLabel</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="NextMonthAsync" />
    </MudStack>
</MudStack>

<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
    Average per-person nutrition versus goals, projected grocery spend against your budget, and the
    month's cooking load. Estimated figures are marked with an asterisk.
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else if (_dashboard is not null)
{
    @if (_dashboard.Alerts.Count > 0)
    {
        <MudStack Spacing="2" Class="mb-4">
            @foreach (var alert in _dashboard.Alerts)
            {
                <MudAlert Severity="@(alert.Level == DashboardAlertLevel.Warning ? Severity.Warning : Severity.Info)"
                          Dense="true">
                    @alert.Message
                </MudAlert>
            }
        </MudStack>
    }

    <MudGrid>
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4" Elevation="1" Style="height: 100%;">
                <MudText Typo="Typo.h6" Class="mb-3">Nutrition (average per day)</MudText>
                @if (_dashboard.CountedDays == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        No normal days are planned this month yet.
                    </MudText>
                }
                else
                {
                    @foreach (var person in _dashboard.People)
                    {
                        <MudText Typo="Typo.subtitle1" Class="mt-3">
                            @person.PersonName@(person.IsEstimated ? "*" : string.Empty)
                        </MudText>
                        @GoalRow("Calories", person.AverageCalories, person.CalorieGoal, "kcal")
                        @GoalRow("Protein", person.AverageProtein, person.ProteinGoal, "g")
                        @GoalRow("Fibre", person.AverageFiber, person.FiberGoal, "g")
                        @GoalRow("Carbs", person.AverageCarbs, person.CarbGoal, "g")
                        @GoalRow("Fat", person.AverageFat, person.FatGoal, "g")
                    }
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="5">
            <MudStack Spacing="4" Style="height: 100%;">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-2">Budget</MudText>
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Baseline">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Projected spend</MudText>
                        <MudText Typo="Typo.h6">
                            @_dashboard.ProjectedSpend.ToString("C", Culture)@(_dashboard.SpendIsEstimated ? "*" : string.Empty)
                        </MudText>
                    </MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Baseline">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Monthly budget</MudText>
                        <MudText Typo="Typo.body1">@_dashboard.MonthlyBudget.ToString("C", Culture)</MudText>
                    </MudStack>
                    @if (_dashboard.MonthlyBudget > 0)
                    {
                        <MudProgressLinear Value="@BudgetProgress"
                                           Color="@(_dashboard.IsOverBudget ? Color.Error : Color.Success)"
                                           Class="my-3"
                                           Size="Size.Large" />
                        <MudText Typo="Typo.body2"
                                 Class="@(_dashboard.IsOverBudget ? "mud-error-text" : "mud-text-secondary")">
                            @if (_dashboard.IsOverBudget)
                            {
                                <text>Over budget by @((-_dashboard.RemainingBudget).ToString("C", Culture)).</text>
                            }
                            else
                            {
                                <text>@_dashboard.RemainingBudget.ToString("C", Culture) remaining.</text>
                            }
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                            Set a monthly budget in <MudLink Href="settings">Settings</MudLink>.
                        </MudText>
                    }
                </MudPaper>

                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-2">Cooking load</MudText>
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Baseline">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Total prep + cook</MudText>
                        <MudText Typo="Typo.h6">@FormatMinutes(_dashboard.Prep.TotalMinutes)</MudText>
                    </MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Baseline">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Average per counted day</MudText>
                        <MudText Typo="Typo.body1">@_dashboard.Prep.AverageMinutesPerCountedDay.ToString("0") min</MudText>
                    </MudStack>
                    @if (_dashboard.Prep.BusiestDate is { } busiest)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Baseline">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Busiest day</MudText>
                            <MudText Typo="Typo.body1">
                                @busiest.ToString("ddd d", CultureInfo.CurrentCulture) &middot; @FormatMinutes(_dashboard.Prep.BusiestDayMinutes)
                            </MudText>
                        </MudStack>
                    }
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @_dashboard.PlannedMealCount planned meal(s) across @_dashboard.CountedDays normal day(s).
                    </MudText>
                </MudPaper>
            </MudStack>
        </MudItem>
    </MudGrid>
}
else
{
    <MudAlert Severity="Severity.Error">
        Could not load the dashboard. Is the API running?
    </MudAlert>
}

@code {
    private static readonly CultureInfo Culture = CultureInfo.GetCultureInfo("en-CA");

    private DashboardDto? _dashboard;
    private bool _loading = true;
    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;

    private string MonthLabel =>
        new DateOnly(_year, _month, 1).ToString("MMMM yyyy", CultureInfo.CurrentCulture);

    private double BudgetProgress =>
        _dashboard is null || _dashboard.MonthlyBudget <= 0
            ? 0
            : Math.Min(100, (double)(_dashboard.ProjectedSpend / _dashboard.MonthlyBudget) * 100);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _dashboard = await Api.GetDashboardAsync(_year, _month);
        }
        catch (HttpRequestException)
        {
            _dashboard = null;
            Snackbar.Add("Could not load the dashboard. Is the API running?", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PreviousMonthAsync()
    {
        var previous = new DateOnly(_year, _month, 1).AddMonths(-1);
        _year = previous.Year;
        _month = previous.Month;
        await LoadAsync();
    }

    private async Task NextMonthAsync()
    {
        var next = new DateOnly(_year, _month, 1).AddMonths(1);
        _year = next.Year;
        _month = next.Month;
        await LoadAsync();
    }

    private RenderFragment GoalRow(string label, double actual, int goal, string unit) =>
        @<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="my-1">
            <MudText Typo="Typo.body2" Style="min-width: 70px;">@label</MudText>
            <MudProgressLinear Value="@GoalProgress(actual, goal)"
                               Color="@GoalColor(actual, goal)"
                               Size="Size.Medium"
                               Style="flex: 1;" />
            <MudText Typo="Typo.body2" Style="min-width: 130px; text-align: right;">
                @actual.ToString("0") / @goal @unit
            </MudText>
        </MudStack>;

    private static double GoalProgress(double actual, int goal) =>
        goal > 0 ? Math.Min(100, actual / goal * 100) : 0;

    private static Color GoalColor(double actual, int goal)
    {
        if (goal <= 0)
        {
            return Color.Default;
        }

        return actual < goal * 0.9 || actual > goal * 1.1 ? Color.Warning : Color.Success;
    }

    private static string FormatMinutes(int minutes)
    {
        if (minutes < 60)
        {
            return $"{minutes} min";
        }

        var hours = minutes / 60;
        var remainder = minutes % 60;
        return remainder == 0 ? $"{hours} h" : $"{hours} h {remainder} min";
    }
}
