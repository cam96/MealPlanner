@page "/recipes/new"
@page "/recipes/{Id:int}"
@using MealPlanner.Contracts
@inject MealPlannerApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "New recipe" : "Edit recipe") - MealPlanner</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">@(IsNew ? "New recipe" : "Edit recipe")</MudText>
    <MudButton Variant="Variant.Text"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="@(() => Navigation.NavigateTo("/recipes"))">
        Back to recipes
    </MudButton>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid>
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4" Elevation="1">
                <MudForm @ref="_form" Model="_model">
                    <MudTextField @bind-Value="_model.Name"
                                  Label="Name"
                                  Required="true"
                                  RequiredError="Name is required."
                                  MaxLength="200" />
                    <MudSelect @bind-Value="_model.MealType" Label="Meal" Class="mt-3">
                        <MudSelectItem Value="MealType.Breakfast">Breakfast</MudSelectItem>
                        <MudSelectItem Value="MealType.Lunch">Lunch</MudSelectItem>
                        <MudSelectItem Value="MealType.Dinner">Dinner</MudSelectItem>
                        <MudSelectItem Value="MealType.Snack">Snack</MudSelectItem>
                    </MudSelect>
                    <MudStack Row="true" Spacing="2" Class="mt-3">
                        <MudNumericField @bind-Value="_model.Servings"
                                         Label="Servings"
                                         Min="1"
                                         Required="true" />
                        <MudNumericField @bind-Value="_model.PrepMinutes" Label="Prep (min)" Min="0" />
                        <MudNumericField @bind-Value="_model.CookMinutes" Label="Cook (min)" Min="0" />
                    </MudStack>
                    <MudTextField @bind-Value="_model.Instructions"
                                  Label="Instructions"
                                  Lines="5"
                                  MaxLength="4000"
                                  Class="mt-3" />
                </MudForm>

                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-5 mb-2">
                    <MudText Typo="Typo.h6">Ingredients</MudText>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               Size="Size.Small"
                               OnClick="AddLine">
                        Add ingredient
                    </MudButton>
                </MudStack>

                @if (_model.Lines.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary pa-2">
                        No ingredients yet. Add lines to build the recipe.
                    </MudText>
                }
                else
                {
                    @foreach (var line in _model.Lines)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                            <MudAutocomplete T="IngredientDto"
                                             Label="Ingredient"
                                             Value="line.Ingredient"
                                             ValueChanged="@(v => OnLineIngredientChanged(line, v))"
                                             SearchFunc="SearchIngredientsAsync"
                                             ToStringFunc="i => i?.Name ?? string.Empty"
                                             ResetValueOnEmptyText="true"
                                             Clearable="true"
                                             Style="flex: 1;" />
                            <MudNumericField @bind-Value="line.Quantity"
                                             Label="Qty"
                                             Min="0"
                                             Style="width: 110px;" />
                            <MudSelect @bind-Value="line.Unit" Label="Unit" Style="width: 130px;">
                                <MudSelectItem Value="MeasurementUnit.Gram">g</MudSelectItem>
                                <MudSelectItem Value="MeasurementUnit.Kilogram">kg</MudSelectItem>
                                <MudSelectItem Value="MeasurementUnit.Pound">lbs</MudSelectItem>
                                <MudSelectItem Value="MeasurementUnit.Millilitre">ml</MudSelectItem>
                                <MudSelectItem Value="MeasurementUnit.Litre">L</MudSelectItem>
                                <MudSelectItem Value="MeasurementUnit.Each">each</MudSelectItem>
                            </MudSelect>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => RemoveLine(line))" />
                        </MudStack>
                    }
                }

                <MudStack Row="true" Spacing="2" Class="mt-5">
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               OnClick="SaveAsync"
                               Disabled="_saving">
                        Save
                    </MudButton>
                    <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/recipes"))">
                        Cancel
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" GutterBottom="true">Per serving</MudText>
                @if (_computed is null)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Save the recipe to calculate nutrition and cost.
                    </MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            <tr>
                                <td>Calories</td>
                                <td>
                                    @_computed.CaloriesPerServing.ToString("0") kcal
                                    @if (_computed.NutritionIsEstimated)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">est.</MudChip>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td>Protein</td>
                                <td>@_computed.ProteinPerServing.ToString("0.0") g</td>
                            </tr>
                            <tr>
                                <td>Fibre</td>
                                <td>@_computed.FiberPerServing.ToString("0.0") g</td>
                            </tr>
                            <tr>
                                <td>Carbs</td>
                                <td>@_computed.CarbsPerServing.ToString("0.0") g</td>
                            </tr>
                            <tr>
                                <td>Fat</td>
                                <td>@_computed.FatPerServing.ToString("0.0") g</td>
                            </tr>
                            <tr>
                                <td>Cost</td>
                                <td>
                                    @_computed.CostPerServing.ToString("C2")
                                    @if (_computed.CostIsEstimated)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">est.</MudChip>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td>Total cost</td>
                                <td>@_computed.TotalCost.ToString("C2")</td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                        Values recalculate each time you save.
                    </MudText>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private MudForm _form = default!;
    private RecipeEditModel _model = new();
    private RecipeDto? _computed;
    private IReadOnlyList<IngredientDto> _ingredients = [];
    private bool _loading = true;
    private bool _saving;

    /// <summary>The recipe identifier when editing; <see langword="null"/> for a new recipe.</summary>
    [Parameter]
    public int? Id { get; set; }

    private bool IsNew => Id is null;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _ingredients = await Api.GetIngredientsAsync();

            if (Id is { } id)
            {
                var recipe = await Api.GetRecipeAsync(id);
                if (recipe is null)
                {
                    Snackbar.Add("Recipe not found.", Severity.Error);
                    Navigation.NavigateTo("/recipes");
                    return;
                }

                _computed = recipe;
                _model = new RecipeEditModel
                {
                    Name = recipe.Name,
                    MealType = recipe.MealType,
                    Servings = recipe.Servings,
                    PrepMinutes = recipe.PrepMinutes,
                    CookMinutes = recipe.CookMinutes,
                    Instructions = recipe.Instructions,
                    Lines = recipe.Ingredients.Select(i => new LineModel
                    {
                        Ingredient = _ingredients.FirstOrDefault(x => x.Id == i.IngredientId),
                        Quantity = i.Quantity,
                        Unit = i.Unit,
                    }).ToList(),
                };
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private Task<IEnumerable<IngredientDto>> SearchIngredientsAsync(string? value, CancellationToken token)
    {
        var matches = string.IsNullOrWhiteSpace(value)
            ? _ingredients
            : _ingredients.Where(i => i.Name.Contains(value, StringComparison.OrdinalIgnoreCase)).ToList();

        return Task.FromResult<IEnumerable<IngredientDto>>(matches);
    }

    private void OnLineIngredientChanged(LineModel line, IngredientDto? ingredient)
    {
        line.Ingredient = ingredient;
        if (ingredient is not null)
        {
            line.Unit = ingredient.BaseUnit;
        }
    }

    private void AddLine() => _model.Lines.Add(new LineModel());

    private void RemoveLine(LineModel line) => _model.Lines.Remove(line);

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        var lines = _model.Lines.Where(l => l.Ingredient is not null).ToList();
        if (lines.Count == 0)
        {
            Snackbar.Add("Add at least one ingredient.", Severity.Warning);
            return;
        }

        var request = new SaveRecipeRequest(
            _model.Name.Trim(),
            _model.MealType,
            _model.PrepMinutes,
            _model.CookMinutes,
            _model.Servings,
            string.IsNullOrWhiteSpace(_model.Instructions) ? null : _model.Instructions.Trim(),
            lines.Select(l => new SaveRecipeIngredientRequest(l.Ingredient!.Id, l.Quantity, l.Unit)).ToList());

        _saving = true;
        try
        {
            if (IsNew)
            {
                var created = await Api.CreateRecipeAsync(request);
                Snackbar.Add($"Added {request.Name}.", Severity.Success);
                if (created is not null)
                {
                    Navigation.NavigateTo($"/recipes/{created.Id}");
                }
            }
            else
            {
                _computed = await Api.UpdateRecipeAsync(Id!.Value, request);
                Snackbar.Add($"Updated {request.Name}.", Severity.Success);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not save the recipe. Is the API running?", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class RecipeEditModel
    {
        public string Name { get; set; } = string.Empty;

        public MealType MealType { get; set; } = MealType.Dinner;

        public int Servings { get; set; } = 1;

        public int PrepMinutes { get; set; }

        public int CookMinutes { get; set; }

        public string? Instructions { get; set; }

        public List<LineModel> Lines { get; set; } = [];
    }

    private sealed class LineModel
    {
        public IngredientDto? Ingredient { get; set; }

        public double Quantity { get; set; }

        public MeasurementUnit Unit { get; set; } = MeasurementUnit.Gram;
    }
}
