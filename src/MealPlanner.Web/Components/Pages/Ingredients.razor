@page "/ingredients"
@attribute [Authorize]
@using MealPlanner.Contracts
@using MealPlanner.Web.Components.Dialogs
@inject MealPlannerApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Ingredients - MealPlanner</PageTitle>

<MudText Typo="Typo.h5" Class="mb-2 d-none d-sm-block">Ingredients</MudText>

@* Sticky search bar *@
<MudPaper Class="pa-2 mb-3 ingredient-search-bar" Elevation="1">
    <MudTextField @bind-Value="_search"
                  Placeholder="Search ingredients…"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true"
                  DebounceInterval="200"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Class="mt-0" />
</MudPaper>

@* Category filter chips *@
<MudChipSet T="FoodCategory?" SelectionMode="SelectionMode.SingleSelection" SelectedValue="_categoryFilter" SelectedValueChanged="OnCategoryFilterChanged" Class="mb-3">
    <MudChip T="FoodCategory?" Value="@((FoodCategory?)null)" Variant="Variant.Outlined" Size="Size.Small">All</MudChip>
    <MudChip T="FoodCategory?" Value="@((FoodCategory?)FoodCategory.Protein)" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small">Protein</MudChip>
    <MudChip T="FoodCategory?" Value="@((FoodCategory?)FoodCategory.Carbohydrate)" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">Carb</MudChip>
    <MudChip T="FoodCategory?" Value="@((FoodCategory?)FoodCategory.Vegetable)" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small">Vegetable</MudChip>
</MudChipSet>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
}

@* Mobile card list *@
<div class="d-block d-md-none">
    @if (FilteredIngredients.Count == 0 && !_loading)
    {
        <MudText Typo="Typo.body2" Class="pa-4 mud-text-secondary">
            @(string.IsNullOrWhiteSpace(_search) ? "No ingredients yet. Tap + to add one." : "No ingredients match your search.")
        </MudText>
    }
    else
    {
        <MudList T="IngredientDto" Dense="true" Class="pa-0">
            @foreach (var item in FilteredIngredients)
            {
                <MudListItem T="IngredientDto" OnClick="@(() => OpenEditorAsync(item))" Class="ingredient-card">
                    <MudStack Spacing="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.body1" Class="fw-bold">@item.Name</MudText>
                            @if (item.IsNutritionEstimated)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">est.</MudChip>
                            }
                        </MudStack>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            @if (item.Category != FoodCategory.None)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@CategoryColor(item.Category)">
                                    @CategoryLabel(item.Category)
                                </MudChip>
                            }
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @item.CaloriesPer100 kcal · @(item.ProteinPer100)g prot · @(item.FiberPer100)g fibre
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudListItem>
                <MudDivider />
            }
        </MudList>
    }
</div>

@* Desktop data grid *@
<div class="d-none d-md-block">
    <MudDataGrid T="IngredientDto"
                 Items="FilteredIngredients"
                 Loading="_loading"
                 Hover="true"
                 Dense="true"
                 Elevation="1">
        <Columns>
            <TemplateColumn Title="Name" SortBy="i => i.Name">
                <CellTemplate>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText>@context.Item.Name</MudText>
                        @if (context.Item.IsNutritionEstimated)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">est.</MudChip>
                        }
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Category" SortBy="i => i.Category">
                <CellTemplate>
                    @if (context.Item.Category != FoodCategory.None)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@CategoryColor(context.Item.Category)">
                            @CategoryLabel(context.Item.Category)
                        </MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="i => i.BaseUnit" Title="Unit" />
            <PropertyColumn Property="i => i.CaloriesPer100" Title="kcal/100" />
            <PropertyColumn Property="i => i.ProteinPer100" Title="Protein" />
            <PropertyColumn Property="i => i.FiberPer100" Title="Fibre" />
            <PropertyColumn Property="i => i.CarbsPer100" Title="Carbs" />
            <PropertyColumn Property="i => i.FatPer100" Title="Fat" />
            <TemplateColumn CellClass="d-flex justify-end" Sortable="false">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   OnClick="@(() => OpenEditorAsync(context.Item))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(() => DeleteAsync(context.Item))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Class="pa-4 mud-text-secondary">
                @(string.IsNullOrWhiteSpace(_search) ? "No ingredients yet. Add the foods you cook with." : "No ingredients match your search.")
            </MudText>
        </NoRecordsContent>
    </MudDataGrid>
</div>

@* FAB — always reachable for adding *@
<MudFab StartIcon="@Icons.Material.Filled.Add"
        Color="Color.Primary"
        Class="fab-bottom-right"
        OnClick="@(() => OpenEditorAsync(null))" />

@code {
    private IReadOnlyList<IngredientDto> _ingredients = [];
    private bool _loading = true;
    private string _search = string.Empty;
    private FoodCategory? _categoryFilter;

    private IReadOnlyList<IngredientDto> FilteredIngredients =>
        _ingredients.Where(i =>
            (string.IsNullOrWhiteSpace(_search)
                || i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
            && (_categoryFilter is null || i.Category == _categoryFilter))
        .ToList();

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private void OnCategoryFilterChanged(FoodCategory? value) => _categoryFilter = value;

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _ingredients = await Api.GetIngredientsAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenEditorAsync(IngredientDto? existing)
    {
        var parameters = new DialogParameters<IngredientDialog> { { x => x.Existing, existing } };
        var title = existing is null ? "Add ingredient" : "Edit ingredient";
        var options = DialogHelper.FormDialog();
        var dialog = await DialogService.ShowAsync<IngredientDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not SaveIngredientRequest request)
        {
            return;
        }

        try
        {
            if (existing is null)
            {
                await Api.CreateIngredientAsync(request);
                Snackbar.Add($"Added {request.Name}.", Severity.Success);
            }
            else
            {
                await Api.UpdateIngredientAsync(existing.Id, request);
                Snackbar.Add($"Updated {request.Name}.", Severity.Success);
            }

            await ReloadAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not save the ingredient. Is the API running?", Severity.Error);
        }
    }

    private async Task DeleteAsync(IngredientDto ingredient)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = "Delete ingredient",
            MarkupMessage = new MarkupString($"Remove {ingredient.Name}? Its recorded prices will be removed too."),
            YesText = "Delete",
            CancelText = "Cancel",
        });

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.DeleteIngredientAsync(ingredient.Id);
            Snackbar.Add($"Deleted {ingredient.Name}.", Severity.Success);
            await ReloadAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not delete the ingredient.", Severity.Error);
        }
    }

    private static string CategoryLabel(FoodCategory category) => category switch
    {
        FoodCategory.Protein => "Protein",
        FoodCategory.Carbohydrate => "Carb",
        FoodCategory.Vegetable => "Veg",
        _ => "—",
    };

    private static Color CategoryColor(FoodCategory category) => category switch
    {
        FoodCategory.Protein => Color.Error,
        FoodCategory.Carbohydrate => Color.Warning,
        FoodCategory.Vegetable => Color.Success,
        _ => Color.Default,
    };
}
