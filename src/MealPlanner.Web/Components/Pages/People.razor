@page "/people"
@using MealPlanner.Web.Components.Dialogs
@inject MealPlannerApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>People - MealPlanner</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">People &amp; goals</MudText>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="@(() => OpenEditorAsync(null))">
        Add person
    </MudButton>
</MudStack>

<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
    Meals are planned to hit each person's daily nutrition targets.
</MudText>

<MudDataGrid T="PersonDto"
             Items="_people"
             Loading="_loading"
             Hover="true"
             Elevation="1">
    <Columns>
        <PropertyColumn Property="p => p.Name" Title="Name" />
        <PropertyColumn Property="p => p.DailyCalorieGoal" Title="Calories (kcal)" />
        <PropertyColumn Property="p => p.DailyProteinGoal" Title="Protein (g)" />
        <PropertyColumn Property="p => p.DailyFiberGoal" Title="Fibre (g)" />
        <PropertyColumn Property="p => p.DailyCarbGoal" Title="Carbs (g)" />
        <PropertyColumn Property="p => p.DailyFatGoal" Title="Fat (g)" />
        <TemplateColumn CellClass="d-flex justify-end" Title="Actions" Sortable="false">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Size="Size.Small"
                               OnClick="@(() => OpenEditorAsync(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               OnClick="@(() => DeleteAsync(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Class="pa-4">No people yet. Add the household members you're planning meals for.</MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    private IReadOnlyList<PersonDto> _people = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _people = await Api.GetPeopleAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenEditorAsync(PersonDto? existing)
    {
        var parameters = new DialogParameters<PersonDialog> { { x => x.Existing, existing } };
        var title = existing is null ? "Add person" : "Edit person";
        var options = DialogHelper.FormDialog();
        var dialog = await DialogService.ShowAsync<PersonDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not SavePersonRequest request)
        {
            return;
        }

        try
        {
            if (existing is null)
            {
                await Api.CreatePersonAsync(request);
                Snackbar.Add($"Added {request.Name}.", Severity.Success);
            }
            else
            {
                await Api.UpdatePersonAsync(existing.Id, request);
                Snackbar.Add($"Updated {request.Name}.", Severity.Success);
            }

            await ReloadAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not save the person. Is the API running?", Severity.Error);
        }
    }

    private async Task DeleteAsync(PersonDto person)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = "Delete person",
            MarkupMessage = new MarkupString($"Remove {person.Name}? This cannot be undone."),
            YesText = "Delete",
            CancelText = "Cancel",
        });

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.DeletePersonAsync(person.Id);
            Snackbar.Add($"Deleted {person.Name}.", Severity.Success);
            await ReloadAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not delete the person.", Severity.Error);
        }
    }
}
