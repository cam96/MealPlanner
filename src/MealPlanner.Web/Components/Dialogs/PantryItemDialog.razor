@using MealPlanner.Contracts
@using MealPlanner.Contracts.Ingredients
@using MealPlanner.Contracts.Pantry

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudAutocomplete T="IngredientDto"
                             Label="Ingredient"
                             @bind-Value="_model.Ingredient"
                             SearchFunc="SearchIngredientsAsync"
                             ToStringFunc="i => i?.Name ?? string.Empty"
                             ResetValueOnEmptyText="true"
                             Required="true"
                             RequiredError="Choose an ingredient."
                             Clearable="true"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Search" />

            <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudNumericField @bind-Value="_model.QuantityOnHand"
                                 Label="Quantity on hand"
                                 Min="0" />
                <MudSelect @bind-Value="_model.Unit" Label="Unit" Style="width: 140px;">
                    <MudSelectItem Value="MeasurementUnit.Gram">g</MudSelectItem>
                    <MudSelectItem Value="MeasurementUnit.Kilogram">kg</MudSelectItem>
                    <MudSelectItem Value="MeasurementUnit.Pound">lbs</MudSelectItem>
                    <MudSelectItem Value="MeasurementUnit.Millilitre">ml</MudSelectItem>
                    <MudSelectItem Value="MeasurementUnit.Litre">L</MudSelectItem>
                    <MudSelectItem Value="MeasurementUnit.Each">each</MudSelectItem>
                </MudSelect>
            </MudStack>

            <MudSelect @bind-Value="_model.Location" Label="Location" Class="mt-3">
                <MudSelectItem Value="StorageLocation.Pantry">Pantry</MudSelectItem>
                <MudSelectItem Value="StorageLocation.Fridge">Fridge</MudSelectItem>
                <MudSelectItem Value="StorageLocation.Freezer">Freezer</MudSelectItem>
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudForm _form = default!;
    private PantryItemEditModel _model = new();

    /// <summary>The dialog instance used to return a result.</summary>
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>The pantry item to edit, or <see langword="null"/> to create a new one.</summary>
    [Parameter]
    public PantryItemDto? Existing { get; set; }

    /// <summary>The ingredients available to choose from.</summary>
    [Parameter]
    public IReadOnlyList<IngredientDto> Ingredients { get; set; } = [];

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Existing is { } item)
        {
            _model = new PantryItemEditModel
            {
                Ingredient = Ingredients.FirstOrDefault(i => i.Id == item.IngredientId),
                QuantityOnHand = item.QuantityOnHand,
                Unit = item.Unit,
                Location = item.Location,
            };
        }
    }

    private Task<IEnumerable<IngredientDto>> SearchIngredientsAsync(string? value, CancellationToken token)
    {
        var matches = string.IsNullOrWhiteSpace(value)
            ? Ingredients
            : Ingredients.Where(i => i.Name.Contains(value, StringComparison.OrdinalIgnoreCase)).ToList();

        return Task.FromResult<IEnumerable<IngredientDto>>(matches);
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || _model.Ingredient is null)
        {
            return;
        }

        var request = new SavePantryItemRequest(
            _model.Ingredient.Id,
            _model.QuantityOnHand,
            _model.Unit,
            _model.Location);

        MudDialog.Close(DialogResult.Ok(request));
    }

    private void Cancel() => MudDialog.Cancel();

    private sealed class PantryItemEditModel
    {
        public IngredientDto? Ingredient { get; set; }

        public double QuantityOnHand { get; set; }

        public MeasurementUnit Unit { get; set; } = MeasurementUnit.Gram;

        public StorageLocation Location { get; set; } = StorageLocation.Pantry;
    }
}
