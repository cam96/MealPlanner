@using System.Reflection
@using MealPlanner.ServiceDefaults.Authorization

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
    <MudNavLink Href="people" Icon="@Icons.Material.Filled.People">People &amp; Goals</MudNavLink>
    <MudNavLink Href="ingredients" Icon="@Icons.Material.Filled.Egg">Ingredients</MudNavLink>
    <MudNavLink Href="prices" Icon="@Icons.Material.Filled.PriceCheck">Prices</MudNavLink>
    <MudNavLink Href="recipes" Icon="@Icons.Material.Filled.MenuBook">Recipes</MudNavLink>
    <MudNavLink Href="pantry" Icon="@Icons.Material.Filled.Kitchen">Pantry &amp; Freezer</MudNavLink>
    <MudNavLink Href="categories" Icon="@Icons.Material.Filled.Category">Meal Categories</MudNavLink>
    <MudNavLink Href="planner" Icon="@Icons.Material.Filled.CalendarMonth">Meal Planner</MudNavLink>
    <MudNavLink Href="shopping-list" Icon="@Icons.Material.Filled.ShoppingCart">Shopping List</MudNavLink>
    <MudNavLink Href="settings" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>

    <AuthorizeView Policy="@AuthorizationPolicies.Admin">
        <Authorized>
            <MudDivider Class="my-2" />
            <MudNavLink Href="user-approvals" Icon="@Icons.Material.Filled.HowToReg">User Approvals</MudNavLink>
            <MudNavLink Href="users" Icon="@Icons.Material.Filled.AdminPanelSettings">User Management</MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

<MudSpacer />
<MudText Typo="Typo.caption" Class="pa-4 mud-text-secondary" Style="position: absolute; bottom: 0;">
    v@(Assembly.GetEntryAssembly()?.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "unknown")
</MudText>

