<Project>

  <!-- Version defaults — overridden at build time by the Docker VERSION arg or CI. -->
  <PropertyGroup>
    <Version>0.0.0-dev</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Common build settings applied to every project in the solution. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML doc comment. Warn but do not fail the build. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!--
      NuGet audit advisories (NU1901-NU1904) are kept as WARNINGS rather than build-fatal
      errors so that a newly published advisory against a transitive dependency does not break
      the build before a patched version is available. Known advisories are actively remediated
      by pinning patched transitive versions in Directory.Packages.props (see the security pins
      there); audit with the NuGet vulnerable-package listing (dotnet list package, vulnerable +
      include-transitive flags).
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
