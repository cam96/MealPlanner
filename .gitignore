# .NET build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
build/
bld/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# .NET / Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
project.lock.json
artifacts/

# Rider / JetBrains
.idea/
*.sln.iml

# VS Code (keep shared settings, ignore local)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Test / coverage results
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.coveragexml
TestResults/

# SQLite database + backups (runtime data, never commit)
*.db
*.db-shm
*.db-wal
data/*.db
data/backups/

# User secrets / local env
*.env
appsettings.*.local.json

# TLS certificates (Cloudflare Origin Certificates — never commit private keys)
certs/*
!certs/cloudflare-origin-pull-ca.pem

# OS files
.DS_Store
Thumbs.db
