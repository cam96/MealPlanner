# MealPlanner reverse proxy — TLS termination for Cloudflare Origin traffic.
# Add additional site blocks below to serve more domains from the same Caddy instance.

mealplanner.cameronmckay.ca {
	tls /etc/caddy/certs/mealplanner.cameronmckay.ca.pem /etc/caddy/certs/mealplanner.cameronmckay.ca.key {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/certs/cloudflare-origin-pull-ca.pem
		}
	}
	# reverse_proxy automatically sends X-Forwarded-For, X-Forwarded-Proto, and X-Forwarded-Host
	# to the backend — the ASP.NET Core ForwardedHeaders middleware reads these to determine the
	# original request scheme (https) for OAuth redirect URIs.
	reverse_proxy web:8080
}
